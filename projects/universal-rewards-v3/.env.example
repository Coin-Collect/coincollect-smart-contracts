# See README.md for defaults and how to load these settings.
# Optional HTTPS Polygon archive RPC for the fork test and market inspection.
COINCOLLECT_V3_POLYGON_RPC=
# Optional override for the pinned Polygon fork block.
COINCOLLECT_V3_FORK_BLOCK=
# Optional loopback HTTP endpoint for the disposable browser fixture.
COINCOLLECT_V3_LOCAL_RPC=
# Optional absolute path to a trusted local Anvil binary.
ANVIL_BIN=
